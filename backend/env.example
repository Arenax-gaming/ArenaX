# Backend Environment Variables

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/arenax
BACKEND_MIGRATION_MODE=run
REDIS_URL=redis://localhost:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# Every secret below must be at least 32 characters long and must NOT be one of
# the known placeholder values (e.g. `supersecretkey`, `changeme`, `password`).
# The backend refuses to start if a required secret is missing, too short, or
# left at a well-known default (#1161).
#
# Generate real values with:  openssl rand -base64 48
# Replace the `dev-only-...` placeholders below before deploying anywhere.

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=dev-only-s3-secret-replace-me-0123456789
S3_BUCKET=arenax

# Payments
# Active gateway for wallet deposits: paystack (default) or flutterwave
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET=dev-only-paystack-secret-replace-me-0123456789
FLUTTERWAVE_SECRET=dev-only-flutterwave-secret-replace-me-0123456789
# Flutterwave webhook verification hash (set in the Flutterwave dashboard).
FLUTTERWAVE_WEBHOOK_HASH=dev-only-flutterwave-webhook-hash-replace-me

# Authentication
JWT_SECRET=dev-only-jwt-secret-replace-me-0123456789abcdef
# Optional dedicated secret for refresh tokens. When unset, refresh tokens are
# signed with JWT_SECRET. When set, the same strength rules apply.
JWT_REFRESH_SECRET=
# Short-lived access token TTL: supports s / m / h / d suffixes (e.g. "15m")
JWT_EXPIRES_IN=15m
# Long-lived refresh token TTL. Defaults to "7d" when unset.
JWT_REFRESH_EXPIRES_IN=7d

# Stellar Configuration
STELLAR_NETWORK_URL=https://horizon-testnet.stellar.org
STELLAR_ADMIN_SECRET=dev-only-stellar-admin-secret-replace-me
SOROBAN_CONTRACT_PRIZE=CAXXX...
SOROBAN_CONTRACT_REPUTATION=CBXXX...
SOROBAN_CONTRACT_ARENAX_TOKEN=CCXXX...
# Optional: defaults to SOROBAN_CONTRACT_PRIZE if not set
SOROBAN_CONTRACT_MATCH=CDXXX...

# AI
AI_MODEL_PATH=./models/anti_cheat.tflite

# Server Configuration
PORT=8080
HOST=0.0.0.0
RUST_LOG=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Optional per-endpoint overrides for the built-in rate-limit buckets.
# Comma-separated `bucket=limit:window` pairs (window in seconds). Bucket
# names: auth_strict, auth, matchmaking_mutate, matchmaking, match_report,
# matches, tournament, staking_mutate, read, default.
# Malformed entries are logged and skipped; unknown names are ignored.
# RATE_LIMIT_OVERRIDES=auth_strict=3:60,tournament=5:120,default=200:60

# Idempotency
# TTL for cached idempotent responses in seconds (default: 86400 = 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400
# Maximum response body size to cache in KB (default: 1024 = 1MB)
IDEMPOTENCY_MAX_RESPONSE_SIZE_KB=1024

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Distributed tracing (OTLP/gRPC — points at a Jaeger or Datadog Agent
# collector). Leave unset to run with local logging only, no trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=arenax-backend
APP_ENV=development

# Email notifications (Issue #905)
# Unset: email is written to the log instead of being delivered.
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Base URL used to build unsubscribe and appeal links in outbound email.
APP_BASE_URL=https://arenax.gg
